rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Preferências visuais (tema, paleta, tamanho do texto).
    // Cada usuário — inclusive os anônimos criados pelo settings.js — só
    // enxerga e escreve no próprio documento, identificado pelo uid.
    match /userSettings/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && configuracaoValida();
    }

    // Qualquer outro caminho continua fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Aceita apenas os três campos que o settings.js usa, com os valores que
// existem de fato na interface. Como o app escreve com { merge: true },
// request.resource.data já representa o documento final — então a checagem
// vale tanto para a criação quanto para atualizações parciais.
function configuracaoValida() {
  let d = request.resource.data;
  return d.keys().hasOnly(['theme', 'paletteId', 'textSizeId'])
    && (!('theme' in d)      || d.theme in ['dark', 'light'])
    && (!('paletteId' in d)  || d.paletteId in ['roxo', 'verde', 'laranja', 'vermelho', 'ciano', 'rosa'])
    && (!('textSizeId' in d) || d.textSizeId in ['sm', 'md', 'lg']);
}
